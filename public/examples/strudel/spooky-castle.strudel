setcpm(170/4)

$drums: stack(
  s("bd").beat("<[8, 12, 16][8,16]>",16),
  s("sd909,cp909").beat("12",16),
).orbit(3)

$bass: stack(
  note(`<
  [C3,E3,G3] [B3,D#3,F#3] [F3,A3,C3] [G3,B3,D3]
  [C3,E3,G3] [G3,B3,D3] [A3,C#3,E3] [F3,A3,C3] 
  [C3,Eb3,G3] [B3,D3,F#3] [F3,Ab3,C3] [G3,Bb3,D3]
  [C3,Eb3,G3] [G3,Bb3,D3] [A3,C3,E3] [F3,Ab3,C3] 
  >`)
)

$highs: stack(
  note(`<
  [[C5 E5 G5 E5] [G5 E5 C5 G5]]
  [[B5 D#5 F#5 B5] [D#5 B5 F#5 B5]]
  [[F5 A5 C5 A5] [F5 A5 C5@2]] 
  [G5 B5 D5 [B5 G5]]
  
  [[C5 E5 G5 E5] [C5 G5 E5 G5]]
  [[G5 B5 D5 G5] [G5 G5 B5 D5]]
  [A5 C#5 E5 C#5]
  [[F5 A5 F5 C5] [F5 A5 C5@2]]
  
  [C5 Eb5 G5 Eb5]
  [B5 D5 [D5 D5] F#5]
  [F5 Ab5 F5 C5]
  [G5 Bb5 G5 [D5 Bb5]]
  
  [[C5 Eb5 G5 C5]  [C5 Eb5 G5 C5]] 
  [G5 Bb5 D5 G5]
  [[A5 C5 E5 C5] [A5 E5 C5 A5]]
  [F5 Ab5 C5@2]
  >`).sound("<supersaw@16 pulse@16 sawtooth@16 triangle@16 square@16>").orbit(2)
)._pianoroll()

